{
  "name": "dom-mudrosti",
  "version": "1.0.0",
  "private": true,
  "description": "Рассказы об учёных исламского мира: сайт с фронтендом и API",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "narration": "node --disable-warning=ExperimentalWarning server/narrate-all.js",
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r tools/requirements.txt",
    "setup:shots": "python3 -m venv .venv && .venv/bin/pip install -r tools/requirements-shots.txt",
    "shots": ".venv/bin/python tools/gen_shots.py",
    "deploy": "npm run build:static && wrangler deploy",
    "preview": "npm run build:static && wrangler dev",
    "build:static": "node --disable-warning=ExperimentalWarning tools/build-static.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  }
}
